# Media Studio AI - Environment Configuration Example

# ==========================================
# API Keys
# ==========================================
GROQ_API_KEY="gsk_..."
OPENAI_API_KEY="sk-proj-..."
OPENROUTER_API_KEY="sk-or-v1-..."
OLLAMA_API_KEY="ollama" # Requerido pela SDK, mas qualquer string serve localmente

# ==========================================
# Default Models
# ==========================================
# Estes modelos serao usados caso o worker nao especifique um na chamada do send_prompt
GROQ_DEFAULT_MODEL="llama-3.3-70b-versatile"
OPENAI_DEFAULT_MODEL="gpt-4o"
OPENROUTER_DEFAULT_MODEL="anthropic/claude-3.5-sonnet"
OLLAMA_DEFAULT_MODEL="llama3.1:8b-instruct-q8_0"

# ==========================================
# Provider Configurations
# ==========================================
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Ordem de tentativa automatica do FallbackProvider (separados por virgula)
FALLBACK_ORDER="groq,openrouter,cerebras,ollama,nvidia,openai"
