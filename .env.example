# AI Workspace Bridge - Environment Configuration Example

# Atualmente, a Bridge NÃO requer nenhuma chave de API!
# Ela utiliza a automação do navegador nativo para interagir com suas contas gratuitas (ChatGPT, Claude, Gemini, DeepSeek).
# 
# Você só precisa estar logado na respectiva plataforma no navegador aberto pela Bridge.
#
# Adicione configurações customizadas de ambiente abaixo, caso necessário para integrações futuras.

# Porta da API
BRIDGE_PORT=8000

# Executar navegador em modo headless (true/false)
BRIDGE_HEADLESS=false

# Diretório base para o Agente Autônomo (Opcional, padrão é o diretório de execução)
BRIDGE_WORKSPACE_DIR=C:\Users\Nome\Projetos\meu-projeto
